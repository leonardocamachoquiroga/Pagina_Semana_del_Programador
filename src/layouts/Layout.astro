---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const { 
  title = "Vibecodear Jueguitos - Semana del Programador 2026", 
  description = "Plataforma oficial de competencias y postas de 10 min de la Semana del Programador - UCB" 
} = Astro.props;
---

<!DOCTYPE html>
<html lang="es" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
  </head>
  <body class="bg-dark-bg text-slate-100 min-h-screen flex flex-col selection:bg-ucb-gold selection:text-dark-bg">
    <!-- Background subtle grid effect -->
    <div class="fixed inset-0 bg-[linear-gradient(to_right,#1e293b15_1px,transparent_1px),linear-gradient(to_bottom,#1e293b15_1px,transparent_1px)] bg-[size:4rem_4rem] [mask-image:radial-gradient(ellipse_60%_50%_at_50%_0%,#000_70%,transparent_100%)] pointer-events-none -z-10"></div>
    
    <!-- Navbar Header -->
    <header class="sticky top-0 z-50 glass-panel border-b border-slate-800/80">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
        
        <!-- Logo & Title -->
        <a href="/" class="flex items-center gap-3 group">
          <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-ucb-gold via-amber-500 to-ucb-accent p-[2px] shadow-lg shadow-amber-500/20 group-hover:scale-105 transition-transform">
            <div class="w-full h-full bg-dark-bg rounded-[10px] flex items-center justify-center font-bold text-ucb-gold font-mono">
              VC
            </div>
          </div>
          <div>
            <div class="flex items-center gap-2">
              <span class="font-extrabold text-lg tracking-tight text-white group-hover:text-ucb-gold transition-colors">
                VIBECODEAR
              </span>
              <span class="text-xs px-2 py-0.5 rounded-full bg-ucb-gold/10 border border-ucb-gold/30 text-ucb-gold font-semibold uppercase tracking-wider">
                Postas
              </span>
            </div>
            <p class="text-[10px] text-slate-400 font-mono tracking-wide">SEMANA DEL PROGRAMADOR - UCB</p>
          </div>
        </a>

        <!-- Dots Divider Center -->
        <div class="hidden md:flex dots-divider">
          <span>●</span>
          <span>●</span>
          <span>●</span>
        </div>

        <!-- Navigation Links -->
        <nav class="flex items-center gap-1 sm:gap-2">
          <a 
            href="/equipo" 
            class="px-3 py-1.5 rounded-lg text-xs sm:text-sm font-medium text-slate-300 hover:text-white hover:bg-slate-800/60 transition-colors flex items-center gap-1.5"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-cyan-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
            <span>Equipos</span>
          </a>

          <a 
            href="/tv" 
            class="px-3 py-1.5 rounded-lg text-xs sm:text-sm font-medium text-slate-300 hover:text-white hover:bg-slate-800/60 transition-colors flex items-center gap-1.5"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-amber-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="15" x="2" y="3" rx="2"/><polyline points="17 2 12 7 7 2"/></svg>
            <span>TV Estaciones</span>
          </a>

          <a 
            href="/moderador" 
            class="px-3 py-1.5 rounded-lg text-xs sm:text-sm font-medium text-slate-300 hover:text-white hover:bg-slate-800/60 transition-colors flex items-center gap-1.5"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-emerald-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
            <span>Moderador</span>
          </a>

          <a 
            href="/ruleta" 
            class="px-3 py-1.5 rounded-lg text-xs font-semibold bg-gradient-to-r from-amber-500 to-ucb-gold text-slate-950 hover:brightness-110 shadow-md shadow-amber-500/20 transition-all flex items-center gap-1.5"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="m12 12 4-4"/><path d="M12 2v4"/><path d="M12 18v4"/></svg>
            <span>Ruleta</span>
          </a>
        </nav>

      </div>
    </header>

    <!-- Main Content Slot -->
    <main class="flex-grow">
      <slot />
    </main>

    <!-- Footer -->
    <footer class="glass-panel border-t border-slate-800/80 mt-12 py-6 text-center text-xs text-slate-500">
      <div class="max-w-7xl mx-auto px-4 flex flex-col sm:flex-row items-center justify-between gap-4">
        <div class="flex items-center gap-2">
          <span class="font-bold text-slate-300">Vibecodear Jueguitos</span>
          <span class="text-slate-600">•</span>
          <span>Sistemas UCB</span>
        </div>

        <div class="dots-divider">
          <span>●</span>
          <span>●</span>
          <span>●</span>
        </div>

        <p class="font-mono text-slate-500 text-[11px]">
          Desarrollado para la Semana del Programador 2026
        </p>
      </div>
    </footer>
  </body>
</html>
