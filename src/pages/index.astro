---
import Layout from '../layouts/Layout.astro';
import { POSTAS } from '../utils/routing';
---

<Layout
  title="Día del Programador | Ingeniería de Sistemas UCB"
  description="Estaciones presenciales de juego para el Día del Programador de Ingeniería de Sistemas UCB."
>
  <div class="home-page">
    <section class="home-launcher" aria-labelledby="home-title">
      <div class="home-launcher__topline">
        <span class="eyebrow">DÍA DEL PROGRAMADOR / INGENIERÍA DE SISTEMAS</span>
        <span class="home-live"><i aria-hidden="true" /> Operación presencial</span>
      </div>

      <div class="home-launcher__title-row">
        <div class="home-launcher__title">
          <span class="home-launcher__index">2026 · UCB</span>
          <h1 id="home-title">Elige una<br /><em>experiencia.</em></h1>
        </div>

        <div class="home-launcher__brief">
          <span class="mono-label">CENTRO DE DESAFÍOS</span>
          <p>Selecciona una estación, juega en esta computadora y entrega el resultado al encargado.</p>
          <a class="button button-primary" href="/tv">
            Ver estaciones
            <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
          </a>
        </div>
      </div>

      <div class="home-route" aria-label="Cómo participar">
        <span><b>01</b> Elige</span>
        <i aria-hidden="true" />
        <span><b>02</b> Resuelve</span>
        <i aria-hidden="true" />
        <span><b>03</b> Valida</span>
      </div>
    </section>

    <section class="home-stations" aria-labelledby="stations-title">
      <div class="section-heading section-heading--compact">
        <div>
          <span class="eyebrow">01 / ESTACIONES</span>
          <h2 id="stations-title">Cinco formas de jugar</h2>
        </div>
        <span class="section-heading__hint">Elige un reto para empezar.</span>
      </div>

      <div class="station-grid">
        {POSTAS.map((posta) => (
          <a class:list={['station-card', `accent-${posta.accent}`]} href={`/tv?posta=${posta.id}`} aria-label={`Jugar ${posta.titulo}`}>
            <div class="station-card__head">
              <span class="station-index">{String(posta.id).padStart(2, '0')}</span>
              <span class="station-tag">{posta.categoria}</span>
            </div>
            <div class="station-card__body">
              <h3>{posta.titulo}</h3>
              <p>{posta.descripcion}</p>
            </div>
            <div class="station-card__footer">
              <span class="station-card__meta">{posta.jugadores} <i aria-hidden="true" /> {posta.duracionMinutos} MIN</span>
              <span class="station-card__cta">Jugar <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 6l6 6-6 6" /></svg></span>
            </div>
          </a>
        ))}
      </div>
    </section>
  </div>
</Layout>
