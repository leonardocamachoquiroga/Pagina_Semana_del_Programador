---
import Layout from '../layouts/Layout.astro';
import { POSTAS } from '../utils/routing';
---

<Layout title="Vibecodear Jueguitos | Semana del Programador 2026 - UCB">
  <div className="w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 space-y-16">
    
    <!-- Hero Banner -->
    <section className="text-center space-y-6 max-w-4xl mx-auto pt-6">
      
      <div className="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-ucb-gold/10 border border-ucb-gold/30 text-ucb-gold text-xs font-semibold tracking-wider uppercase">
        <span>●</span>
        <span>SEMANA DEL PROGRAMADOR 2026</span>
        <span>●</span>
      </div>

      <h1 className="text-4xl sm:text-6xl lg:text-7xl font-black text-white tracking-tight leading-none">
        Vibecodear <span>Jueguitos</span>
      </h1>

      <p className="text-base sm:text-xl text-slate-300 max-w-2xl mx-auto font-light leading-relaxed">
        Plataforma oficial de competencias por postas de 10 minutos. Desafíos de código, retos físicos, juegos lógicos y gran ruleta final de premios.
      </p>

      <!-- Dots Divider UCB NODE -->
      <div className="dots-divider justify-center py-2 text-base">
        <span>●</span>
        <span>●</span>
        <span>●</span>
      </div>

      <!-- Quick Action Buttons -->
      <div className="flex flex-wrap items-center justify-center gap-4 pt-2">
        <a
          href="/equipo"
          className="px-6 py-3.5 rounded-2xl bg-gradient-to-r from-cyan-500 to-blue-600 hover:from-cyan-400 hover:to-blue-500 text-slate-950 font-extrabold text-sm shadow-xl shadow-cyan-500/25 transition-all flex items-center gap-2"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-slate-950" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/></svg>
          <span>Ingreso de Equipos (Móvil)</span>
        </a>

        <a
          href="/tv"
          className="px-6 py-3.5 rounded-2xl bg-slate-900 hover:bg-slate-800 text-white font-bold text-sm border border-slate-700 hover:border-amber-400/50 shadow-lg transition-all flex items-center gap-2"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-amber-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="15" x="2" y="3" rx="2"/><polyline points="17 2 12 7 7 2"/></svg>
          <span>Pantallas TV Estaciones</span>
        </a>

        <a
          href="/moderador"
          className="px-6 py-3.5 rounded-2xl bg-slate-900 hover:bg-slate-800 text-slate-200 font-bold text-sm border border-slate-700 hover:border-emerald-400/50 shadow-lg transition-all flex items-center gap-2"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-emerald-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
          <span>Panel Moderador</span>
        </a>

        <a
          href="/ruleta"
          className="px-6 py-3.5 rounded-2xl bg-gradient-to-r from-amber-500 to-ucb-gold text-slate-950 font-black text-sm shadow-xl shadow-amber-500/25 hover:brightness-110 transition-all flex items-center gap-2"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="m12 12 4-4"/></svg>
          <span>Ruleta de Premios</span>
        </a>
      </div>
    </section>

    <!-- Stations Showcase Grid -->
    <section className="space-y-8">
      <div className="text-center space-y-2">
        <h2 className="text-3xl font-extrabold text-white">
          Estaciones y <span>Postas de 10 min</span>
        </h2>
        <p className="text-sm text-slate-400">
          5 estaciones interactivas diseñadas para desafiar al máximo el talento de los equipos.
        </p>
      </div>

      <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {POSTAS.map((posta) => (
          <div
            key={posta.id}
            className="glass-panel p-6 rounded-2xl border-slate-800/80 hover:border-cyan-500/40 transition-all space-y-4 card-numbered group"
            data-number={`0${posta.id}`}
          >
            <div className="flex items-center justify-between">
              <span className="px-2.5 py-0.5 rounded-full text-[10px] font-bold font-mono bg-cyan-500/20 text-cyan-400 border border-cyan-500/30">
                POSTA 0{posta.id}
              </span>
              <span className="text-xs font-mono text-slate-400">Encargado: {posta.encargado}</span>
            </div>

            <div className="space-y-1">
              <h3 className="text-xl font-bold text-white group-hover:text-cyan-300 transition-colors">
                {posta.titulo}
              </h3>
              <p className="text-xs text-slate-300 leading-relaxed">
                {posta.descripcion}
              </p>
            </div>

            <div className="pt-2 flex items-center justify-between border-t border-slate-800/80 text-xs">
              <span className="text-slate-400 font-mono">PIN: {posta.pin}</span>
              <a
                href={`/tv?posta=${posta.id}`}
                className="text-cyan-400 hover:text-cyan-300 font-semibold flex items-center gap-1 group-hover:translate-x-1 transition-transform"
              >
                Abrir en TV &rarr;
              </a>
            </div>
          </div>
        ))}
      </div>
    </section>

  </div>
</Layout>
