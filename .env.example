# Public Supabase configuration (safe to expose in the browser)
PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key

# Server-only configuration. Never use these in client-side code.
SUPABASE_SERVICE_ROLE_KEY=your-secret-or-service-role-key
MODERATOR_PIN=change-this-for-the-event
MODERATOR_SESSION_SECRET=use-a-long-random-secret
